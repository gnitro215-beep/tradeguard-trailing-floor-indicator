//@version=5
indicator("TradeGuard Trailing Floor & Account Shield", overlay=true)

// User Inputs
drawdown_buffer = input.float(2000.0, title="Trailing Drawdown Buffer ($)")
tick_value      = input.float(20.0, title="Dollar Value per 1.0 Price Point ($)", tooltip="Per contract/lot. NQ = 20, MNQ = 2, ES = 50, MES = 5")
contract_size   = input.float(1.0, title="Position Contracts / Lots")
reset_daily     = input.bool(true, title="Reset Anchor Each Session/Day")

// State Tracking
var float high_water_mark = na
var float trailing_floor   = na

// Dollar buffer conversion to chart price points
buffer_points = (drawdown_buffer / (tick_value * contract_size))

// Session boundary check (Daily reset)
is_new_session = reset_daily and ta.change(time("D")) != 0

if barstate.isfirst or is_new_session
    high_water_mark := high
    trailing_floor   := high - buffer_points
else
    if high > high_water_mark
        high_water_mark := high
        calc_floor = high_water_mark - buffer_points
        if calc_floor > trailing_floor
            trailing_floor := calc_floor

// Plots
plot(high_water_mark, title="High-Water Mark (Peak)", color=color.new(color.blue, 20), style=plot.style_circles, linewidth=1)
plot(trailing_floor, title="TradeGuard Drawdown Floor", color=color.new(color.red, 0), style=plot.style_line, linewidth=2)

// Floor breach: shade the chart and expose an alert
breached = close < trailing_floor
bgcolor(breached ? color.new(color.red, 85) : na, title="Floor Breach Shading")
alertcondition(ta.crossunder(close, trailing_floor), title="Price crossed below TradeGuard floor", message="{{ticker}} closed below the TradeGuard trailing floor")

// Point value reminder on non-futures charts (defaults assume NQ at $20 per point)
var table warn_table = table.new(position.bottom_right, 1, 1)
if barstate.islast and syminfo.type != "futures"
    warn_text = "Not a futures chart: set 'Dollar Value per 1.0 Price Point' for " + syminfo.ticker + " (symbol point value: " + str.tostring(syminfo.pointvalue) + ")"
    table.cell(warn_table, 0, 0, warn_text, text_color=color.white, bgcolor=color.new(color.orange, 20), text_size=size.small)
